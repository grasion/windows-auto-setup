install_file/*
!install_file/.gitkeep
# 사용자 설정과 설치 로그
settings.json
logs/

# ---- 빌드 결과물 (GitHub 릴리스로 배포) ----
AutoSetup.exe
*.exe.old
*.exe.new

# ---- 저장소에 올리지 않는 로컬 파일 ----
# 블로그 원고
blog/
# 예전 배치 파일 방식
auto_install.bat
setup_auto_install.bat
